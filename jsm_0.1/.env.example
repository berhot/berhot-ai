# Cloudflare R2 bucket that holds the corpus files.
# Copy to .env (ignored by git) and fill in. Create the key in the
# Cloudflare dashboard: R2 > Manage API tokens > Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional folder inside the bucket, for a bucket shared with other projects.
R2_PREFIX=
